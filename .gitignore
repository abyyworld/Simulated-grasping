# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/

# Vendored simulation assets (fetched by `make assets`)
assets/franka_emika_panda/

# Generated data / runs / media.
#
# These are anchored with a leading slash so they match only the directories at
# the repository root. Without the anchor, "data/" also matched
# src/simgrasp/data/, and that package was silently excluded from every commit:
# the published repository could not import simgrasp at all. See
# tests/test_repo_integrity.py, which now fails if any tracked source directory
# becomes ignored.
/data/
/runs/
media/*
# ...except the two assets the README embeds, which must ship with the repo.
!media/.gitkeep
!media/grasp_demo.gif
!media/predictions.png
/outputs/
*.npy
*.npz
*.pt
*.ckpt

# MuJoCo writes this wherever it is run from.
MUJOCO_LOG.TXT

# Private notes, never published.
EXPLAIN-THIS-PROJECT.private.*
.private/

# OS
.DS_Store
.simgrasp_gl_backend
